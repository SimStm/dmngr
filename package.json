{
  "name": "dmngr",
  "version": "0.1.0",
  "description": "Instala e atualiza apps do macOS a partir de DMG/PKG (URL ou arquivo) sem abrir o Finder",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "dmngr": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "DMNGR_INTEGRATION=1 bun test tests/integration",
    "test:all": "bun test",
    "build": "bun build ./src/index.ts --compile --outfile dist/dmngr",
    "build:arm64": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/dmngr-darwin-arm64",
    "build:x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile dist/dmngr-darwin-x64"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
